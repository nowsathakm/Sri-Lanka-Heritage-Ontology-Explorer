    :hasEntryFeeUSD "0.0"^^xsd:decimal ;
    :isUNESCOListed "false"^^xsd:boolean ;
    :siteDescription "Prominent Hindu temple in Jaffna dedicated to Lord Murugan." .

:StAnthonysShrine rdf:type owl:NamedIndividual , :ChristianChurch ;
    rdfs:label "St. Anthony's Shrine" ;
    :locatedIn :WesternProv ;
    :hasActivity :PilgrimageActivity ;
    :hasEntryFeeUSD "0.0"^^xsd:decimal ;
    :isUNESCOListed "false"^^xsd:boolean ;
    :siteDescription "Popular Catholic shrine in Colombo, visited by people of all faiths." .

:JamiUlAlfarMosque rdf:type owl:NamedIndividual , :MosqueSite ;
    rdfs:label "Jami-Ul-Alfar Mosque" ;
