    :hasActivity :SightseeingActivity ;
    :hasEntryFeeUSD "5.0"^^xsd:decimal ;
    :yearInscribed "1877"^^xsd:int ;
    :isUNESCOListed "false"^^xsd:boolean ;
    :siteDescription "Sri Lanka's largest museum, housing royal and historical artefacts." .

:NallurKovil rdf:type owl:NamedIndividual , :HinduKovil ;
    rdfs:label "Nallur Kovil" ;
    :locatedIn :NorthernProv ;
