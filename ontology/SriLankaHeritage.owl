  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#ReligiousPilgrimageSite">
    <rdfs:label>Religious Pilgrimage Site</rdfs:label>
    <rdfs:comment>Defined class: any religious site that offers pilgrimage as an activity.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b22">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
          <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b23">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#hasActivity">
                <rdfs:label>has activity</rdfs:label>
                <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
                <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
                <owl:inverseOf rdf:resource="http://www.srilanka-heritage.org/ontology#isActivityOf"/>
                <rdfs:comment>Relates a tourist site to an activity that can be done there.</rdfs:comment>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:hasValue rdf:resource="http://www.srilanka-heritage.org/ontology#PilgrimageActivity"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
  </owl:Class>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b33">
    <owl:members rdf:parseType="Collection">
