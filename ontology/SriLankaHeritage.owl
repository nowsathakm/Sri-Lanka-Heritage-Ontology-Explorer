  <owl:Ontology rdf:about="http://www.srilanka-heritage.org/ontology">
    <rdfs:label>Sri Lanka Heritage and Tourism Sites Ontology</rdfs:label>
    <rdfs:comment>An ontology describing Sri Lanka's heritage and tourism sites: their type, geographic location, activities offered, UNESCO status, and entry fees. Developed as coursework for Semantic Web and Ontologies.</rdfs:comment>
  </owl:Ontology>
  <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#JamiUlAlfarMosque">
    <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#MosqueSite"/>
    <rdfs:label>Jami-Ul-Alfar Mosque</rdfs:label>
    <locatedIn rdf:resource="http://www.srilanka-heritage.org/ontology#WesternProv"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#SightseeingActivity"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#PhotographyActivity"/>
    <hasEntryFeeUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</hasEntryFeeUSD>
    <yearInscribed rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1909</yearInscribed>
    <isUNESCOListed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isUNESCOListed>
    <siteDescription>Iconic red-and-white candy-striped mosque in Colombo Pettah.</siteDescription>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#NuwaraEliyaTeaEstate">
    <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#TeaPlantation"/>
    <rdfs:label>Nuwara Eliya Tea Estate</rdfs:label>
    <locatedIn rdf:resource="http://www.srilanka-heritage.org/ontology#CentralProv"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#SightseeingActivity"/>
    <hasEntryFeeUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</hasEntryFeeUSD>
    <isUNESCOListed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isUNESCOListed>
    <hasElevationMeters rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1868.0</hasElevationMeters>
    <siteDescription>Highland tea estate and factory in Sri Lanka's Ceylon tea country.</siteDescription>
  </owl:NamedIndividual>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b30">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#ArchaeologicalSite"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#AdamsPeak">
    <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#MountainPeak"/>
    <rdfs:label>Adam's Peak</rdfs:label>
    <locatedIn>
      <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#SabaragamuwaProv">
        <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#SabaragamuwaProvince"/>
        <rdfs:label>Sabaragamuwa Province</rdfs:label>
        <partOfRegion rdf:resource="http://www.srilanka-heritage.org/ontology#SriLanka"/>
      </owl:NamedIndividual>
    </locatedIn>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#HikingActivity"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#PilgrimageActivity"/>
    <hasEntryFeeUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</hasEntryFeeUSD>
    <hasElevationMeters rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2243.0</hasElevationMeters>
    <isUNESCOListed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isUNESCOListed>
    <siteDescription>Sacred mountain (Sri Pada) revered by multiple religions, climbed at night.</siteDescription>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="http://www.srilanka-heritage.org/ontology#hasElevationMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>has elevation (m)</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Elevation of the site above sea level, in metres.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#BentotaBeach">
    <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#Beach"/>
    <rdfs:label>Bentota Beach</rdfs:label>
    <locatedIn rdf:resource="http://www.srilanka-heritage.org/ontology#WesternProv"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#SurfingActivity"/>
    <hasActivity rdf:resource="http://www.srilanka-heritage.org/ontology#SightseeingActivity"/>
    <hasEntryFeeUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</hasEntryFeeUSD>
    <isUNESCOListed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</isUNESCOListed>
    <siteDescription>Popular beach resort town known for water sports.</siteDescription>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#FreeEntrySite">
    <rdfs:label>Free Entry Site</rdfs:label>
    <rdfs:comment>Defined class: any tourist site with a 0.0 USD entry fee. Membership is inferred by the reasoner.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b14">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#TouristSite"/>
          <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b15">
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="http://www.srilanka-heritage.org/ontology#hasEntryFeeUSD">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                <rdfs:label>has entry fee (USD)</rdfs:label>
                <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
                <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <rdfs:comment>Foreign-visitor entry fee in US dollars. 0.0 means free entry.</rdfs:comment>
              </owl:DatatypeProperty>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.srilanka-heritage.org/ontology#siteDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>site description</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A short human-readable description of the site.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#AdventureSite">
    <rdfs:label>Adventure Site</rdfs:label>
    <rdfs:comment>Defined class: any tourist site offering at least one adventure activity (hiking, safari, or surfing).</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b18">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#TouristSite"/>
          <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b19">
            <owl:onProperty rdf:resource="http://www.srilanka-heritage.org/ontology#hasActivity"/>
            <owl:someValuesFrom rdf:resource="http://www.srilanka-heritage.org/ontology#AdventureActivity"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b42">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#NationalPark"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Beach"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Waterfall"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#MountainPeak"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#WildlifeSanctuary"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b52">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#WesternProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#CentralProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#SouthernProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#UvaProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#SabaragamuwaProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#NorthCentralProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#NorthWesternProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#NorthernProvince"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#EasternProvince"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b62">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Hiking"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#WildlifeSafari"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Surfing"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Pilgrimage"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Sightseeing"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Photography"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#nearbyTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>nearby to</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:comment>Relates two tourist sites that are geographically close enough to visit on the same trip. Symmetric: if A is nearby B, then B is nearby A.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b38">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#AncientCity"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#FortSite"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#CaveTempleSite"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b48">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Museum"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#TeaPlantation"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#BotanicalGarden"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#UNESCOWorldHeritageSite">
    <rdfs:label>UNESCO World Heritage Site</rdfs:label>
    <rdfs:comment>Defined class: any tourist site whose isUNESCOListed value is true. Membership is inferred by the reasoner, never asserted directly.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b10">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#TouristSite"/>
          <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b11">
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="http://www.srilanka-heritage.org/ontology#isUNESCOListed">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                <rdfs:label>is UNESCO listed</rdfs:label>
                <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
                <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                <rdfs:comment>True if the site is a UNESCO World Heritage Site.</rdfs:comment>
              </owl:DatatypeProperty>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#CaveTempleSite">
    <rdfs:label>Cave Temple</rdfs:label>
    <rdfs:comment>A temple built within a natural cave.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ArchaeologicalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#EasternProvince">
    <rdfs:label>Eastern Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Photography">
    <rdfs:label>Photography</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#partOfRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>part of region</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#GeographicRegion"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#GeographicRegion"/>
    <rdfs:comment>Relates a geographic region to the larger region that contains it (e.g. a Province is part of the Country). Transitive, so containment chains correctly.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#NorthWesternProvince">
    <rdfs:label>North Western Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#MosqueSite">
    <rdfs:label>Mosque</rdfs:label>
    <rdfs:comment>A religious site used for Islamic worship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#TeaPlantation">
    <rdfs:label>Tea Plantation</rdfs:label>
    <rdfs:comment>A working tea estate open to visitors, part of Sri Lanka's Ceylon tea industry.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#CulturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#UvaProvince">
    <rdfs:label>Uva Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Museum">
    <rdfs:label>Museum</rdfs:label>
    <rdfs:comment>A museum housing cultural or historical artefacts.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#CulturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#HinduKovil">
    <rdfs:label>Hindu Kovil</rdfs:label>
    <rdfs:comment>A religious site used for Hindu worship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#BotanicalGarden">
    <rdfs:label>Botanical Garden</rdfs:label>
    <rdfs:comment>A curated garden of plant collections open to the public.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#CulturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Surfing">
    <rdfs:label>Surfing</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#AdventureActivity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#FortSite">
    <rdfs:label>Fort</rdfs:label>
    <rdfs:comment>A fortified historical structure or fortified town.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ArchaeologicalSite"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#isLocationOf">
    <rdfs:label>is location of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:comment>Inverse of locatedIn.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#AncientCity">
    <rdfs:label>Ancient City</rdfs:label>
    <rdfs:comment>The ruins of a historical city or settlement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ArchaeologicalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#WesternProvince">
    <rdfs:label>Western Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Province">
    <rdfs:label>Province</rdfs:label>
    <rdfs:comment>One of Sri Lanka's nine administrative provinces.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#GeographicRegion"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#NationalPark">
    <rdfs:label>National Park</rdfs:label>
    <rdfs:comment>A protected natural area managed for conservation and wildlife viewing. Activities offered at a national park are restricted to sightseeing, photography, hiking, and safari.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#NaturalSite"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b4">
        <owl:onProperty rdf:resource="http://www.srilanka-heritage.org/ontology#hasActivity"/>
        <owl:allValuesFrom>
          <owl:Class rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b5">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Sightseeing"/>
              <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Photography"/>
              <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#Hiking"/>
              <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#WildlifeSafari"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#GeographicRegion">
    <rdfs:label>Geographic Region</rdfs:label>
    <rdfs:comment>A geographic administrative area, such as a Province or a Country.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#ReligiousSite">
    <rdfs:label>Religious Site</rdfs:label>
    <rdfs:comment>A heritage site used for worship or pilgrimage.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#HeritageSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#WildlifeSanctuary">
    <rdfs:label>Wildlife Sanctuary</rdfs:label>
    <rdfs:comment>A managed sanctuary for the protection of wildlife.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#NaturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Sightseeing">
    <rdfs:label>Sightseeing</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#NaturalSite">
    <rdfs:label>Natural Site</rdfs:label>
    <rdfs:comment>A site whose main attraction is a natural feature or wildlife.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Pilgrimage">
    <rdfs:label>Pilgrimage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#ChristianChurch">
    <rdfs:label>Christian Church</rdfs:label>
    <rdfs:comment>A religious site used for Christian worship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#HeritageSite">
    <rdfs:label>Heritage Site</rdfs:label>
    <rdfs:comment>A site of historical, religious, or archaeological significance.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Activity">
    <rdfs:label>Activity</rdfs:label>
    <rdfs:comment>Something a visitor can do at a tourist site.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#SabaragamuwaProvince">
    <rdfs:label>Sabaragamuwa Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#WildlifeSafari">
    <rdfs:label>Wildlife Safari</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#AdventureActivity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#CulturalSite">
    <rdfs:label>Cultural Site</rdfs:label>
    <rdfs:comment>A site representing living culture, industry, or curated knowledge, such as a museum or plantation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#isActivityOf">
    <rdfs:label>is activity of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:comment>Inverse of hasActivity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Country">
    <rdfs:label>Country</rdfs:label>
    <rdfs:comment>A sovereign country. Used here so that a site's country membership can be inferred through a property chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#GeographicRegion"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#locatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>located in</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
    <owl:inverseOf rdf:resource="http://www.srilanka-heritage.org/ontology#isLocationOf"/>
    <rdfs:comment>Relates a tourist site to the single province it is located in. Functional: a site has exactly one province.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#AdventureActivity">
    <rdfs:label>Adventure Activity</rdfs:label>
    <rdfs:comment>An outdoor, physically active pursuit. Used to define AdventureSite.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#BuddhistTemple">
    <rdfs:label>Buddhist Temple</rdfs:label>
    <rdfs:comment>A religious site used for Buddhist worship.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#ReligiousSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#NorthCentralProvince">
    <rdfs:label>North Central Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#SouthernProvince">
    <rdfs:label>Southern Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#MountainPeak">
    <rdfs:label>Mountain Peak</rdfs:label>
    <rdfs:comment>A mountain or hill-country peak.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#NaturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Hiking">
    <rdfs:label>Hiking</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Activity"/>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#AdventureActivity"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#TouristSite">
    <rdfs:label>Tourist Site</rdfs:label>
    <rdfs:comment>The top-level class for any place in Sri Lanka that tourists can visit. Every tourist site is located in exactly one province.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n9c443b349c7343d199a8cb7f28f1aa67b3">
        <owl:onProperty rdf:resource="http://www.srilanka-heritage.org/ontology#locatedIn"/>
        <owl:onClass rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Waterfall">
    <rdfs:label>Waterfall</rdfs:label>
    <rdfs:comment>A natural waterfall site.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#NaturalSite"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://www.srilanka-heritage.org/ontology#SriLanka">
    <rdf:type rdf:resource="http://www.srilanka-heritage.org/ontology#Country"/>
    <rdfs:label>Sri Lanka</rdfs:label>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#CentralProvince">
    <rdfs:label>Central Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#NorthernProvince">
    <rdfs:label>Northern Province</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#Province"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#Beach">
    <rdfs:label>Beach</rdfs:label>
    <rdfs:comment>A coastal recreational site.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#NaturalSite"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.srilanka-heritage.org/ontology#ArchaeologicalSite">
    <rdfs:label>Archaeological Site</rdfs:label>
    <rdfs:comment>A heritage site consisting of historical ruins or remains.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.srilanka-heritage.org/ontology#HeritageSite"/>
  </owl:Class>
</rdf:RDF>
