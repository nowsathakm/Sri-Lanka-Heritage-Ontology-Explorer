  <owl:ObjectProperty rdf:about="http://www.srilanka-heritage.org/ontology#locatedInCountry">
    <rdfs:label>located in country</rdfs:label>
    <rdfs:domain rdf:resource="http://www.srilanka-heritage.org/ontology#TouristSite"/>
    <rdfs:range rdf:resource="http://www.srilanka-heritage.org/ontology#Country"/>
    <rdfs:comment>Derived property: a tourist site's country, inferred via the property chain locatedIn o partOfRegion. Never asserted directly on an individual.</rdfs:comment>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#locatedIn"/>
      <rdf:Description rdf:about="http://www.srilanka-heritage.org/ontology#partOfRegion"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
